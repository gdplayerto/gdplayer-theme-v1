{% include 'elements/header.twig' %}

<script type="text/javascript" src="{{ base_url }}assets/vendor/promise-polyfill/8.3.0/polyfill.min.js"></script>
{% if productionMode %}
    <script type="text/javascript" src="{{ base_url }}assets/vendor/dd.js" defer></script>
    <script type="text/javascript">
        (function(){var devToolsOpened=false;if(typeof devtoolsDetector!=="undefined"){devtoolsDetector.addListener(function(isOpen,event){devToolsOpened=isOpen});devtoolsDetector.launch()}setInterval(function(){if(devToolsOpened){if(typeof jQuery!=="undefined"){var $=jQuery;$(".btn-watch, .alert, #title").hide();$("#dlWrapper").html('<h1 class="h3" style="text-align:center">Do not open Developer Tools! <a href="javascript:void(0)" onclick="location.href=location.href">Reload</a></h1>');$(document).ajaxSend(function(event,jqXHR,settings){jqXHR.abort()})}location.href="https://google.com"}},1000)})();
    </script>
{% endif %}
{% if templates.blockadb %}
    {% include templates.blockadb %}
{% endif %}
<script type="text/javascript">{{ jsVars|raw }}</script>

<div class="row my-5 pt-5">
    <div class="col-12 col-md-10 mx-auto">
        {% if disable_banner_ads != 1 and dl_banner_top is not empty %}
            <div class="mb-3">{{ dl_banner_top|raw }}</div>
        {% endif %}

        {% if isError %}
        {% else %}
            <div class="card mb-3 shadow-sm">
                <h1 class="card-header mb-0 h4 text-center">Download {{ title is empty ? 'No Title' : title }}</h1>
                <div class="card-body">
                    <div class="alert alert-success">
                        To increase download speed in Chrome (Chromium based) browser, you just need to enable <strong>Parallel downloading</strong> feature in your <strong>chrome://flags</strong> setting page.
                    </div>
                    <div id="dlWrapper"></div>
                </div>
            </div>

            <div class="card shadow-sm">
                <h2 class="card-header mb-0 h4 text-center d-block">Watch {{ title is empty ? 'No Title' : title }}</h2>
                <div class="card-body p-0">
                    <div class="embed-responsive embed-responsive-16by9">
                        <iframe class="embed-responsive-item" src="{{ embedURL }}" loading="lazy" title="{{ title }}" allowfullscreen></iframe>
                    </div>
                </div>
                <div class="card-footer p-3">
                    <ul class="nav nav-pills" id="myTab">
                        <li class="nav-item">
                            <button class="nav-link active" id="download-tab" data-toggle="tab" data-target="#download" type="button" role="tab" aria-controls="download" aria-selected="true">Download URL</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="embed-tab" data-toggle="tab" data-target="#embed" type="button" role="tab" aria-controls="embed" aria-selected="true">Embed URL</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="bb-tab" data-toggle="tab" data-target="#bb" type="button" role="tab" aria-controls="bb" aria-selected="false">Forum BB Code</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="html-tab" data-toggle="tab" data-target="#html" type="button" role="tab" aria-controls="html" aria-selected="false">HTML Code</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="embed-code-tab" data-toggle="tab" data-target="#embed-code" type="button" role="tab" aria-controls="embed-code" aria-selected="false">Embed Code</button>
                        </li>
                    </ul>
                    <div class="tab-content pt-3" id="myTabContent">
                        <div class="tab-pane fade show active" id="download" role="tabpanel" aria-labelledby="download-tab">
                            <textarea class="form-control" aria-labelledby="download-tab" rows="5" readonly>{{ xtrim(base_url, '/') }}{{ current_url() }}</textarea>
                        </div>
                        <div class="tab-pane fade" id="embed" role="tabpanel" aria-labelledby="embed-tab">
                            <textarea class="form-control" aria-labelledby="embed-tab" rows="5" readonly>{{ embedURL }}</textarea>
                        </div>
                        <div class="tab-pane fade" id="bb" role="tabpanel" aria-labelledby="bb-tab">
                            <textarea class="form-control" aria-labelledby="bb-tab" rows="5" readonly>[URL={{ embedURL }}]{% if poster is not empty %}[IMG]{{ poster }}[/IMG]{% endif %}{{ title }}[/URL]
                            </textarea>
                        </div>
                        <div class="tab-pane fade" id="html" role="tabpanel" aria-labelledby="html-tab">
                            <textarea class="form-control" aria-labelledby="html-tab" rows="5" readonly>&lt;a href=&quot;{{ embedURL }}&quot;&gt;{% if poster is not empty %}&lt;img src=&quot;{{ poster }}&quot; border=0&gt;&lt;br&gt;{% endif %}{{ title }}&lt;/a&gt;&lt;br&gt;</textarea>
                        </div>
                        <div class="tab-pane fade" id="embed-code" role="tabpanel" aria-labelledby="embed-code-tab">
                            <textarea class="form-control" aria-labelledby="embed-code-tab" rows="5" readonly>&lt;iframe title=&quot;{{ title }}&quot; src=&quot;{{ embedURL }}&quot; width=&quot;640&quot; height=&quot;320&quot; loading=&quot;lazy&quot; allow=&quot;fullscreen; accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; geolocation; web-share; screen-wake-lock; idle-detection&quot;&gt;&lt;/iframe&gt;</textarea>
                        </div>
                    </div>
                </div>
            </div>

            <script type="text/javascript" src="{{ base_url }}assets/vendor/crypto-js/4.2.0/crypto-js.min.js" defer></script>
            <script type="text/javascript" src="{{ base_url }}assets/js/download-v{{ downloadVersion }}.min.js" async></script>
        {% endif %}

        {% if disable_banner_ads != 1 and dl_banner_bottom is not empty %}
            <div class="mt-3">{{ dl_banner_bottom|raw }}</div>
        {% endif %}
    </div>
</div>

{% include 'elements/footer.twig' %}